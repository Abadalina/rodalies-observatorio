# Copia este fichero a `.env` y rellena las contrasenas.
# `.env` esta en .gitignore: aqui nunca se sube una credencial real.
#
# El perfil `demo` no necesita nada de esto: trae sus propias credenciales
# locales y su propio volumen.  docker compose --profile demo up -d

# --- Credenciales (obligatorias para el perfil live) -------------------------
POSTGRES_USER=rodalies
POSTGRES_PASSWORD=
POSTGRES_DB=rodalies

# Contrasena del rol PostgreSQL de SOLO LECTURA que usan Grafana y cualquier
# consumidor externo. Distinta de la anterior: si se filtra el panel, lo maximo
# que se puede hacer con ella es leer.
READONLY_PASSWORD=

GRAFANA_USER=admin
GRAFANA_PASSWORD=

# --- Conexion ----------------------------------------------------------------
# Dentro de Docker el host es `db`; desde el equipo, `localhost` con el puerto
# publicado mas abajo.
RODALIES_DATABASE_URL=postgresql://rodalies:LA_MISMA_CLAVE@localhost:5433/rodalies

# --- Fuente de datos ---------------------------------------------------------
# renfe     = feeds oficiales en tiempo real
# synthetic = red simulada, sin red ni espera (lo que usa el perfil demo)
# replay    = reproduce capturas guardadas en data/captures
RODALIES_SOURCE=renfe

# json o pb. Traen exactamente lo mismo; lo verifica un test con dos capturas
# reales del mismo instante. json evita depender de protobuf en ejecucion.
RODALIES_FEED_FORMAT=json

RODALIES_RT_BASE_URL=https://gtfsrt.renfe.com
RODALIES_GTFS_STATIC_URL=https://ssl.renfe.com/ftransit/Fichero_CER_FOMENTO/fomento_transit.zip

# Nucleos de Cercanias a guardar. 51 = Rodalies de Barcelona.
# Lista separada por comas, o `all` para toda Espana (unas diez veces mas datos).
RODALIES_NUCLEOS=51

# --- Cadencias (validadas al arrancar; fuera de rango el proceso no inicia) ---
# El feed se actualiza cada ~20 s. 60 da resolucion de sobra sin castigar un
# servicio publico gratuito.
RODALIES_POLL_SECONDS=60
RODALIES_REFRESH_SECONDS=900
RODALIES_GTFS_RELOAD_SECONDS=86400
RODALIES_HTTP_TIMEOUT=30
RODALIES_HTTP_RETRIES=3

RODALIES_INGEST_ALERTS=true
RODALIES_INGEST_VEHICLE_POSITIONS=false

# Ciclos que puede fallar un feed antes de que /salud devuelva 503.
RODALIES_HEALTH_MAX_MISSED_CYCLES=3

# --- Definicion de puntualidad ----------------------------------------------
# Se sincronizan con la tabla analytics.setting al arrancar el ingestor, de modo
# que redefinir "puntual" es un UPDATE y un refresco, no reescribir las vistas.
RODALIES_ON_TIME_THRESHOLD_S=180
RODALIES_LATE_THRESHOLD_S=300
RODALIES_SEVERE_THRESHOLD_S=900

# --- Operacion ---------------------------------------------------------------
RODALIES_LOG_LEVEL=INFO
RODALIES_LOG_JSON=false
RODALIES_EXPORT_DIR=data/export
RODALIES_REPLAY_DIR=data/captures

# --- Puertos (siempre se publican solo en 127.0.0.1) -------------------------
POSTGRES_PORT=5433
API_PORT=8000
GRAFANA_PORT=3000
# Acceso anonimo al panel: cerrado por defecto. Abrirlo solo detras de un proxy
# inverso con TLS, nunca con la base de datos expuesta.
GRAFANA_ANONYMOUS=false
