            "type": "postgres",
            "uid": "rodalies-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\nSELECT feed              AS \"Feed\",\n       source            AS \"Origen\",\n       ultima_consulta   AS \"Ultima consulta\",\n       antiguedad_s      AS \"Antiguedad (s)\",\n       consultas_1h      AS \"Consultas (1 h)\",\n       fallos_1h         AS \"Fallos (1 h)\",\n       sin_cambios_1h    AS \"Sin cambios (1 h)\",\n       filas_1h          AS \"Filas (1 h)\",\n       latencia_media_ms AS \"Latencia (ms)\",\n       ultimo_error      AS \"Ultimo error\"\n  FROM analytics.v_ingest_health\n ORDER BY feed\n",
          "sql": {
            "columns": [
              {
