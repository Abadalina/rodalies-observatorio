          "rawQuery": true,
          "rawSql": "\nSELECT date_trunc('hour', polled_at) AS time,\n       feed AS metric,\n       round(avg(duration_ms)) AS latencia_ms\n  FROM rt.feed_poll\n WHERE $__timeFilter(polled_at)\n GROUP BY 1, 2\n ORDER BY 1\n",
