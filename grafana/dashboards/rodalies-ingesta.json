    {
      "id": 22,
      "title": "Filas escritas por hora",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "rodalies-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "rodalies-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "\nSELECT date_trunc('hour', polled_at) AS time,\n       feed AS metric,\n       sum(rows_written) AS filas\n  FROM rt.feed_poll\n WHERE $__timeFilter(polled_at)\n GROUP BY 1, 2\n ORDER BY 1\n",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": []
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
