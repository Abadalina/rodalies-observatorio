          "rawQuery": true,
          "rawSql": "\nSELECT downloaded_at AS \"Descargado\",\n       n_trips       AS \"Trenes\",\n       n_stop_times  AS \"Paradas programadas\",\n       duration_ms   AS \"Duracion (ms)\",\n       left(sha256, 12) AS \"SHA-256\"\n  FROM gtfs.feed_version\n ORDER BY downloaded_at DESC\n LIMIT 10\n",
