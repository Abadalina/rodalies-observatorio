          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "description": "Ordenado por retraso medio. La mediana y el P90 estan en la API."
    },
    {
