      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "rodalies-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\nSELECT round(100.0 * sum(paradas_puntuales) / NULLIF(sum(paradas_con_retraso), 0), 1)\n         AS \"Puntualidad (%)\"\n  FROM analytics.mv_line_daily\n WHERE service_date BETWEEN $__timeFrom()::date AND $__timeTo()::date\n   AND source = '$source'\n   AND nucleo_id = '$nucleo'\n   AND linea LIKE ANY (ARRAY[${linea:sqlstring}])\n",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": []
          }
        }
      ],
      "options": {
