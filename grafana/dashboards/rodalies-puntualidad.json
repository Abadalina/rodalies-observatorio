          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "\nSELECT service_date::timestamptz AS time,\n       linea AS metric,\n       round(100.0 * paradas_puntuales / NULLIF(paradas_con_retraso, 0), 1) AS puntualidad\n  FROM analytics.mv_line_daily\n WHERE service_date BETWEEN $__timeFrom()::date AND $__timeTo()::date\n   AND source = '$source'\n   AND nucleo_id = '$nucleo'\n   AND linea LIKE ANY (ARRAY[${linea:sqlstring}])\n ORDER BY 1\n",
