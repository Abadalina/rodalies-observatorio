    {
      "id": 1,
      "title": "Puntualidad",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "rodalies-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
