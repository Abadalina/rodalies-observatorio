      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "rodalies-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\nSELECT estacion                                                    AS \"Estacion\",\n       round(sum(retraso_medio_s * paradas_con_retraso)\n             / NULLIF(sum(paradas_con_retraso), 0), 0)              AS \"Retraso medio (s)\",\n       max(retraso_max_s)                                          AS \"Peor retraso (s)\",\n       sum(paradas_observadas)                                     AS \"Observaciones\"\n  FROM analytics.mv_station_daily\n WHERE service_date BETWEEN $__timeFrom()::date AND $__timeTo()::date\n   AND source = '$source'\n   AND nucleo_id = '$nucleo'\n GROUP BY estacion\nHAVING sum(paradas_observadas) >= 20\n ORDER BY 2 DESC\n LIMIT 15\n",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": []
