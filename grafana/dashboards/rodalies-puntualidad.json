          "rawQuery": true,
          "rawSql": "\nSELECT last_seen_at AS \"Visto por ultima vez\",\n       array_to_string(lineas, ', ') AS \"Lineas\",\n       COALESCE(header_text, description_text) AS \"Aviso\"\n  FROM analytics.v_alertas_activas\n ORDER BY 1 DESC\n LIMIT 20\n",
          "sql": {
