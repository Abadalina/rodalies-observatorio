          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\nSELECT hora AS \"Hora\",\n       linea AS \"Linea\",\n       round(sum(retraso_medio_s * paradas_con_retraso)\n             / NULLIF(sum(paradas_con_retraso), 0), 0) AS \"Retraso medio (s)\"\n  FROM analytics.mv_line_hour\n WHERE service_date BETWEEN $__timeFrom()::date AND $__timeTo()::date\n   AND source = '$source'\n   AND nucleo_id = '$nucleo'\n   AND linea LIKE ANY (ARRAY[${linea:sqlstring}])\n GROUP BY hora, linea\n ORDER BY hora, linea\n",
