    {
      "id": 6,
      "title": "Ranking de lineas",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "rodalies-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "rodalies-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\nSELECT linea AS \"Linea\",\n       round(sum(retraso_medio_s * paradas_con_retraso)\n             / NULLIF(sum(paradas_con_retraso), 0), 0)              AS \"Retraso medio (s)\",\n       round(100.0 * sum(paradas_puntuales)\n             / NULLIF(sum(paradas_con_retraso), 0), 1)              AS \"Puntualidad (%)\",\n       max(retraso_p90_s)::int                                     AS \"P90 (s)\",\n       sum(trenes)                                                 AS \"Trenes\"\n  FROM analytics.mv_line_daily\n WHERE service_date BETWEEN $__timeFrom()::date AND $__timeTo()::date\n   AND source = '$source'\n   AND nucleo_id = '$nucleo'\n   AND linea LIKE ANY (ARRAY[${linea:sqlstring}])\n GROUP BY linea\n ORDER BY 2 DESC\n",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": []
          }
        }
      ],
